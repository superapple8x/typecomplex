{
  "name": "typecomplex-electron",
  "version": "1.0.0",
  "description": "Desktop version of TypeComplex",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node ./tests/apiClient.test.js && node ./tests/processManager.spec.js && node ./tests/settings.spec.js && node ./tests/settings.migrations.spec.js && node ./tests/settings.export_import.spec.js",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0",
    "proxyquire": "^2.1.3"
  },
  "dependencies": {
    "electron-store": "^10.1.0"
  },
  "build": {
    "appId": "com.example.typecomplex",
    "productName": "TypeComplex",
    "files": [
      "main.js",
      "apiClient.js",
      "preload.js",
      "pythonProcessManager.js",
      "store.js",
      "renderer/**",
      "dist/flask_server/flask_server"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"]
    }
  }
}